name: Release Please

on:
  push:
    branches: [main]

permissions:
  contents: write
  pull-requests: write

jobs:
  release-please:
    runs-on: ubuntu-latest
    steps:
      # v4.1.3
      - uses: googleapis/release-please-action@cc61a2e92c7c37cd79e80e1427d8ddc8b1d8b339
        with:
          release-type: simple
